# Campus OS — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection URL
DATABASE_URL=postgresql://campus_os:campus_os@localhost:5432/campus_os

# For tests: separate database to avoid polluting dev data
TEST_DATABASE_URL=postgresql://campus_os:campus_os@localhost:5432/campus_os_test

# ── Security ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-randomly-generated-hex-string-at-least-32-chars

# ── Demo configuration ───────────────────────────────────────────────────
# Password for seeded demo users (principal, HODs). Change before any live demo.
DEMO_PASSWORD=changeme

# Fixed "today" for reproducible demos and tests.
# Format: YYYY-MM-DD. Tests inject their own date via fixtures.
DEMO_TODAY=2026-10-26

# ── LLM / Groq (optional — system works without this) ───────────────────
# Set LLM_PROVIDER=groq to enable natural-language features.
# Without a key, the system uses the deterministic fallback automatically.
LLM_PROVIDER=fallback
GROQ_API_KEY=
GROQ_MODEL=

# ── CORS (frontend origins allowed to call the backend) ──────────────────
ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Institution defaults ─────────────────────────────────────────────────
INSTITUTION_TIMEZONE=Asia/Kolkata
